VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Social login (Auth page + Settings -> Account -> Connected accounts)
# Google: enable Firebase Console -> Authentication -> Sign-in method -> Google.
#         No client secret goes here; the button works once the provider is on.
#         Linking for existing users uses linkWithPopup — nothing extra to configure.
# Discord: OAuth2 via the Supabase `discord-auth` Edge Function (Discord is not a
#          native Firebase provider). Steps:
#            1. Discord Developer Portal -> New Application -> OAuth2. Copy the
#               Client ID (public, goes below) and Client Secret (server-only).
#            2. Add all four OAuth2 redirect URIs — login and account linking use
#               different callback routes:
#                 login: http://localhost:3000/auth
#                        https://hivespell-db.web.app/auth
#                 link:  http://localhost:3000/link/discord
#                        https://hivespell-db.web.app/link/discord
#            3. Set Supabase function secrets (never in this file, never in
#               .env.local — the service-role key must not reach the browser):
#                 DISCORD_CLIENT_ID
#                 DISCORD_CLIENT_SECRET
#                 FIREBASE_SERVICE_ACCOUNT      (the full service-account JSON)
#                 SUPABASE_URL                  (same value as VITE_SUPABASE_URL)
#                 SUPABASE_SERVICE_ROLE_KEY     (used to write profiles.discord_id)
#               then deploy:
#                 supabase functions deploy discord-auth --no-verify-jwt
#            4. Apply migration 20260829000000_add_profiles_discord_id.sql so the
#               `discord_id` column, its unique index and its write guard exist.
#            5. Set the two client vars below; flip the flag to "true" to show the button.
VITE_DISCORD_CLIENT_ID=your_discord_client_id
VITE_ENABLE_DISCORD_LOGIN=false

#Cloudfare R2
