# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
dev-dist/
# generated at build time by scripts/generate-health.mjs
public/health.json

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Environment / secrets (never commit) ----
.env
.env.*
# tracked placeholder — real values live in .env.local
!.env.template

# ---- Firebase ----
.firebase/

# ---- Supabase CLI local state ----
supabase/.temp/

# ---- Test / E2E artifacts ----
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
# transient i18next-parser output (npm run i18n:check)
.i18n-tmp/

# ---- Tooling scratch ----
# Playwright MCP scratch output
.playwright-mcp/
# regenerable UI screenshots (~8MB of PNGs)
ui-audit/
# local knowledge-graph memory (not part of the app)
graphify-out/

# ---- Build/CI scripts: ignore scratch (audio staging, ad-hoc utilities),
#      keep the ones our build and CI actually depend on tracked ----
/scripts/*
!/scripts/generate-health.mjs
!/scripts/check-i18n.mjs
!/scripts/check-env.mjs

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Claude Code local state ----
.claude/settings.local.json
tasks/
